<?xml version="1.0" encoding="utf-8"?>
<!--
    The app never shows a platform-drawn View, so these themes exist for one
    reason only: the window the system paints *before* Compose renders its
    first frame. Getting `android:windowBackground` right is what removes the
    white flash on cold start.

    `Theme.FocusReef.Starting` is the launch theme (Android 12+ splash screen,
    backported by core-splashscreen). It hands over to `Theme.FocusReef` via
    `postSplashScreenTheme` once the activity is up.

    See values-night/themes.xml for the dark variants.
-->
<resources>

    <!-- The resting theme: a window background that matches the Compose surface. -->
    <style name="Theme.FocusReef" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/reef_window_background</item>
    </style>

    <!-- The launch theme: reef background, the fish mark, then hand over. -->
    <style name="Theme.FocusReef.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/reef_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.FocusReef</item>
    </style>

</resources>
